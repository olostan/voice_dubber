# GEMINI_API_KEY: Required for Gemini AI API calls on the backend.
# Configured in .env or Secret Manager for Cloud Functions.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Firebase Web Client Configuration (Optional in local dev, injected at build time)
VITE_FIREBASE_API_KEY="your_firebase_web_api_key_here"
VITE_FIREBASE_AUTH_DOMAIN="fun-voice-dubber.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="fun-voice-dubber"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"
